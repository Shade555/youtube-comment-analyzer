# ---------------------------------------------------------------------------
# YouTube Data API
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=your_api_key_here
MAX_COMMENTS=100
# ---------------------------------------------------------------------------
# Supabase (auth + Postgres) -- from Project Settings
#
# These two are the ONLY required values. The VITE_ prefix makes them readable by
# Vite in the browser, and the backend reads the same names as a fallback, so one
# pair configures both sides. SUPABASE_URL / SUPABASE_ANON_KEY also work.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Server-only key (never expose to the browser). Only used by
# `python -m backend.scripts.migrate_sqlite_to_supabase`.
SUPABASE_SERVICE_ROLE_KEY=

# Legacy HS256 JWT secret (Project Settings -> API -> JWT Settings). When set,
# the backend verifies access tokens locally with no network round-trip. Leave
# blank if your project uses the newer asymmetric (ES256) signing keys - the
# backend then verifies against the project's JWKS endpoint automatically.
SUPABASE_JWT_SECRET=

# Postgres connection string (Project Settings -> Database -> Connection string).
# Optional: leave this blank (or as the placeholder below) and the backend runs on
# a local SQLite file at backend/app.db. Fill it in to move app data to Supabase,
# then run: python -m backend.scripts.migrate_sqlite_to_supabase
# Prefer the Supavisor pooler on port 6543 and remember to substitute the project
# ref *and* the database password you chose when the project was created:
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres
# DATABASE_URL is an alias and wins if both are set:
# DATABASE_URL=

# "supabase" (the default once SUPABASE_URL is set) or "local".
# AUTH_MODE=supabase
# Set to true to keep the local email/password endpoints alive during migration:
# ALLOW_LOCAL_AUTH=false
# Extra origins allowed to call the API (comma separated), e.g. a deployment:
# CORS_ORIGINS=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# Local fallback auth -- only used when Supabase is NOT configured
# ---------------------------------------------------------------------------
SECRET_KEY=your_long_random_secret_here
ACCESS_TOKEN_EXPIRE_MINUTES=10080
